<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Bar with Share Summary & Sync -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#2196F3"
                android:text="@string/title_lecturer_roster"
                android:textColor="@color/primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShareSummary"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                app:icon="@android:drawable/ic_menu_share" />

            <Button
                android:id="@+id/btnSyncNow"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sync"
                app:icon="@android:drawable/stat_notify_sync" />
        </LinearLayout>

        <!-- Active Group Counts Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/tvGroupCountsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#8A98E6"
                android:backgroundTint="#ABAEB3"
                android:padding="10dp"
                android:text="Group Totals: G01: 0/15 | G02: 0/15 | G03: 0/15 | G04: 0/15 | Unassigned: 0"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/text_field_bg"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeWidth="2dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#7F7F81"
                android:contentDescription="@string/cd_search_input"
                android:hint="Search student name or 9-digit number..."
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorLink="#1B1B1B"
                android:visibility="visible" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filters Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programme Filter"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFilterProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/text_primary"
                    android:backgroundTint="#7982A9"
                    android:contentDescription="@string/cd_programme_filter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Group Filter"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerFilterGroup"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/text_primary"
                    android:backgroundTint="#777FAB"
                    android:contentDescription="@string/cd_group_filter"
                    android:foregroundTint="#1F0C0C"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Roster RecyclerView -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F4F4"
            android:backgroundTint="#FFFFFF">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentRoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- Floating Action Button to Add Student -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddStudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/cd_add_student_fab"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
