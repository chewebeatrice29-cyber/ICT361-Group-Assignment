<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#6200EE"
        app:navigationIcon=" @drawable/ic_arrow_back"
        app:navigationIconTint="#FFFFFF"
        app:title="Reset Password"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot your password?"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the email address you used to register. We'll email you a code to reset your password."
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address *"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#1976D2"
                android:layout_marginBottom="24dp"
                android:importantForAutofill="no">


                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendResetButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SEND RESET CODE"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:backgroundTint="#1976D2"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no"/>

            <TextView
                android:id="@+id/resendCodeLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resend Code (30s)"
                android:textSize="14sp"
                android:textColor="#888888"
                android:gravity="center"
                android:padding="8dp"
                android:enabled="false"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/backToSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Sign In"
                android:textSize="14sp"
                android:textColor="#1976D2"
                android:gravity="center"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>