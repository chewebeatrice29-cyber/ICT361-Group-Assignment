<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeWidth="1dp"
    app:strokeColor="@color/text_field_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvSubItemAssignmentId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ICT361 Lab Practical 3"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <TextView
                android:id="@+id/tvSubItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRADED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@color/text_field_bg"
                android:textColor="@color/status_synced" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSubItemText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room DB &amp; Sync implementation completed successfully."
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSubItemLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://github.com/jamesbanda/ICT361_Lab3.git"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:autoLink="web"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/text_field_bg"
            android:padding="8dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvSubItemGrade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Grade: 92 / 100 Marks"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <TextView
                android:id="@+id/tvSubItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="26 Sep 2025"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSubItemFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedback: Excellent implementation of DAOs and asynchronous sync workers!"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="@color/text_secondary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
