<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#E3F2FD"
        app:boxStrokeColor="#1565C0"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSchedDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Activity Title (e.g. ICT361 Study Group)" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#E3F2FD"
        app:boxStrokeColor="#1565C0"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSchedDialogTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Day &amp; Time (e.g. Wednesday 03:00 PM)" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#E3F2FD"
        app:boxStrokeColor="#1565C0"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSchedDialogLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Venue / Location (e.g. Library Room 3)" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
