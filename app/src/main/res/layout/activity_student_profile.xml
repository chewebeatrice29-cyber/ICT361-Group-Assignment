<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Offline Banner Indicator -->
            <TextView
                android:id="@+id/tvOfflineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline_banner_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#E65100"
                android:padding="8dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- Cover Photo Banner & Profile Picture Overlap Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="56dp">

                <!-- Cover Photo Banner -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:src="@drawable/mulungushi_campus_bg"
                    android:scaleType="centerCrop"
                    android:contentDescription="Cover Photo" />

                <!-- Camera Cover Photo Edit Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#CC000000">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#FFFFFF"
                        android:contentDescription="Edit Cover" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Circular Profile Picture Overlapping Bottom Center -->
                <FrameLayout
                    android:id="@+id/btnChangeProfilePhoto"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="bottom|center"
                    android:layout_marginBottom="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="64dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#FFFFFF">

                        <ImageView
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_launcher_foreground"
                            android:scaleType="centerCrop"
                            android:background="#1565C0"
                            android:contentDescription="Profile Picture" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Profile Camera Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="5dp"
                        app:cardBackgroundColor="#1565C0">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#FFFFFF"
                            android:contentDescription="Edit Profile Photo" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </FrameLayout>

            <!-- Name, Stats, Bio & Actions Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvStudentGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="James Banda"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark" />

                <TextView
                    android:id="@+id/tvStudentNumberDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="336 friends • 128 posts"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="living in the moment • student at Mulungushi University"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvProgrammeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Lusaka  •  Computer Science Student"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <!-- Action Buttons: Add to Story & Edit Profile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnAddToStory"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="+ Add to story"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1565C0"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnEditProfileTop"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Edit profile"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/text_field_bg"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Timetable Button -->
                <Button
                    android:id="@+id/btnViewProfileTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📅 View Class Timetable"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#184E77"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Profile Filter Tabs: All, Photos, Reels, Memories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posts"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="@color/text_field_bg"
                        android:backgroundTint="#1565C0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Photos"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friends"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Personal & User Details Section Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Personal &amp; User Details"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="12dp" />

                    <!-- Detail item 1: Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lives in Lusaka, Zambia"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Detail item 2: Hometown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="🏠"
                            android:textSize="16sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="From Kamwala, Lusaka City"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Detail item 3: Student Number / Group -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="🎓"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvDetailStudentNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student # 202109428 • Computer Science"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Detail item 4: Lab Group -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="👥"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvDetailGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lab Group G01 (12 / 15 members)"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Detail item 5: Sync Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:text="🔄"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvDetailSyncStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sync Status: Synced with Server"
                            android:textSize="14sp"
                            android:textColor="@color/status_synced" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/menu_student_bottom_nav"
        app:backgroundTint="#FFFFFF"
        app:itemIconTint="#1565C0"
        app:itemTextColor="#1565C0" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
