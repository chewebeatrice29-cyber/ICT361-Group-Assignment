<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_student"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#E3F2FD"
            app:boxStrokeColor="#1565C0"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#1565C0"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditorStudentNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0D233A"
                android:textColorHint="#4A5568"
                android:textSize="16sp"
                android:textStyle="bold"
                android:hint="@string/label_student_number"
                android:inputType="number"
                android:maxLength="9" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="#E3F2FD"
            app:boxStrokeColor="#1565C0"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="#1565C0"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditorStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0D233A"
                android:textColorHint="#4A5568"
                android:textSize="16sp"
                android:textStyle="bold"
                android:hint="@string/label_student_name"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_programme"
            android:textColor="#0D233A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerEditorProgramme"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_lab_group"
            android:textColor="#0D233A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerEditorGroup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="16dp" />

        <!-- Registered Courses Section (Matching PDF Page 2 / 3) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registered Courses (select one or more)"
            android:textColor="#0D233A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbCourseCS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Computer Science (CS)"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCourseSE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Software Engineering (SE)"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCourseIS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Information Systems (IS)"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCourseDB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Database Systems (DB)"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCourseWT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web Technologies (WT)"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbCourseMC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Computing (MC)"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnEditorSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_save"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEditorDelete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_delete"
            android:textColor="#C62828"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#C62828"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
